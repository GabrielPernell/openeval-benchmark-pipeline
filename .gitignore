# Fetched source data and conversion outputs. This repo is code only -- the
# converted items and responses are published in the OpenEval HF dataset.
data_cache/
output/
output_with_responses/
repo_export/

# Upstream files copied in from open-eval/OpenEval, not part of this project.
validator.py
item_schema.json

# Tooling for reviewing incoming HF dataset PRs is tracked; the id dumps,
# reports and downloaded artifacts it produces are not.
pr_review/*
!pr_review/*.py

# Model-summary ID listings are ~190 MB each and regenerable from parts/.
# The counts, tables, and merge audits are small and are tracked.
model_summary/parts/
model_summary/*_full.json
*.zip

# Run logs
*.log

# Local editor/preview config (machine-specific absolute paths).
.claude/

# Python
__pycache__/
*.py[cod]
.venv/
